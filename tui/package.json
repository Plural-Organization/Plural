    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "bun": "^1.4.4",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5"
  }
