        "proposal_id": {
          "type": "string"
        },
        "type": {
          "const": "proposal.decide",
          "default": "proposal.decide",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "decision"
      ],
      "type": "object"
