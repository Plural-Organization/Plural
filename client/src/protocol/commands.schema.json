{
  "$defs": {
    "AdmissionMode": {
      "enum": [
        "approve",
        "open"
      ],
      "type": "string"
    },
    "AdmissionSet": {
      "properties": {
        "mode": {
          "$ref": "#/$defs/AdmissionMode"
        },
        "type": {
          "const": "link.set_admission",
          "default": "link.set_admission",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "AgentsCreate": {
      "properties": {
        "description": {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        "model": {
          "default": "fast",
          "enum": [
            "fast",
            "main"
          ],
          "type": "string"
        },
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "prompt": {
          "maxLength": 8000,
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/SkillScope",
          "default": "project"
        },
        "tools": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "type": {
          "const": "agents.create",
          "default": "agents.create",
          "type": "string"
        }
      },
      "required": [
        "name",
        "description",
        "prompt"
      ],
      "type": "object"
    },
    "AgentsRemove": {
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "agents.remove",
          "default": "agents.remove",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "ApprovalDecision": {
      "enum": [
        "once",
        "always",
        "reject",
        "block"
      ],
      "type": "string"
    },
    "ApprovalRespond": {
      "properties": {
        "approval_id": {
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/ApprovalDecision"
        },
        "type": {
          "const": "approval.respond",
          "default": "approval.respond",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "decision"
      ],
      "type": "object"
    },
    "AttachmentFetch": {
      "description": "Asks for the picture of an image on the board; only those are handed out.",
      "properties": {
        "attachment_id": {
          "maxLength": 64,
          "type": "string"
        },
        "type": {
          "const": "attachment.fetch",
          "default": "attachment.fetch",
          "type": "string"
        }
      },
      "required": [
        "attachment_id"
      ],
      "type": "object"
    },
    "BoardClear": {
      "description": "Clears the board; with mine, only the sender's own marks, which anyone who draws may do.",
      "properties": {
        "mine": {
          "default": false,
          "type": "boolean"
        },
        "type": {
          "const": "board.clear",
          "default": "board.clear",
          "type": "string"
        }
      },
      "type": "object"
    },
    "BoardCursor": {
      "description": "Where someone points on the board; with ink, the pen is down and draws.",
      "properties": {
        "color": {
          "anyOf": [
            {
              "pattern": "^#[0-9a-fA-F]{6}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ink": {
          "default": false,
          "type": "boolean"
        },
        "width": {
          "anyOf": [
            {
              "maximum": 40,
              "minimum": 0.5,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "x": {
          "maximum": 4,
          "minimum": 0,
          "type": "number"
        },
        "y": {
          "maximum": 4,
          "minimum": 0,
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "type": "object"
    },
    "BoardDraw": {
      "properties": {
        "color": {
          "pattern": "^#[0-9a-fA-F]{6}$",
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/BoardShape",
          "default": "pen"
        },
        "points": {
          "items": {
            "maximum": 4,
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 4000,
          "minItems": 2,
          "type": "array"
        },
        "text": {
          "anyOf": [
            {
              "maxLength": 500,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "board.draw",
          "default": "board.draw",
          "type": "string"
        },
        "width": {
          "maximum": 40,
          "minimum": 0.5,
          "type": "number"
        }
      },
      "required": [
        "color",
        "width",
        "points"
      ],
      "type": "object"
    },
    "BoardErase": {
      "properties": {
        "stroke_id": {
          "type": "string"
        },
        "type": {
          "const": "board.erase",
          "default": "board.erase",
          "type": "string"
        }
      },
      "required": [
        "stroke_id"
      ],
      "type": "object"
    },
    "BoardMove": {
      "description": "Moves or resizes a mark: its points, the same kind and count as before.",
      "properties": {
        "points": {
          "items": {
            "maximum": 4,
            "minimum": 0,
            "type": "number"
          },
          "maxItems": 4000,
          "minItems": 2,
          "type": "array"
        },
        "stroke_id": {
          "type": "string"
        },
        "type": {
          "const": "board.move",
          "default": "board.move",
          "type": "string"
        }
      },
      "required": [
        "stroke_id",
        "points"
      ],
      "type": "object"
    },
    "BoardOpen": {
      "properties": {
        "open": {
          "type": "boolean"
        },
        "type": {
          "const": "board.open",
          "default": "board.open",
          "type": "string"
        }
      },
      "required": [
        "open"
      ],
      "type": "object"
    },
    "BoardShape": {
      "enum": [
        "pen",
        "line",
        "arrow",
        "rect",
        "ellipse",
        "text",
        "image",
        "erase"
      ],
      "type": "string"
    },
    "ChatSend": {
      "properties": {
        "mentions": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "chat.send",
          "default": "chat.send",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "ClientInfo": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "version"
      ],
      "type": "object"
    },
    "ContextCompact": {
      "properties": {
        "type": {
          "const": "context.compact",
          "default": "context.compact",
          "type": "string"
        }
      },
      "type": "object"
    },
    "CursorSet": {
      "properties": {
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/BoardCursor"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "presence.cursor",
          "default": "presence.cursor",
          "type": "string"
        }
      },
      "required": [
        "cursor"
      ],
      "type": "object"
    },
    "Delivery": {
      "enum": [
        "now",
        "steer",
        "follow_up"
      ],
      "type": "string"
    },
    "FileAttach": {
      "properties": {
        "content_b64": {
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "type": {
          "const": "file.attach",
          "default": "file.attach",
          "type": "string"
        }
      },
      "required": [
        "name",
        "content_b64",
        "sha256"
      ],
      "type": "object"
    },
    "HistoryGet": {
      "properties": {
        "before_seq": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limit": {
          "default": 100,
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "const": "history.get",
          "default": "history.get",
          "type": "string"
        }
      },
      "type": "object"
    },
    "InviteCreate": {
      "properties": {
        "reusable": {
          "default": false,
          "type": "boolean"
        },
        "role": {
          "$ref": "#/$defs/Role",
          "default": "participant"
        },
        "ttl_s": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 60,
          "type": "integer"
        },
        "type": {
          "const": "invite.create",
          "default": "invite.create",
          "type": "string"
        }
      },
      "type": "object"
    },
    "JoinDecide": {
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "viewer",
            "deny"
          ],
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "type": {
          "const": "join.decide",
          "default": "join.decide",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "decision"
      ],
      "type": "object"
    },
    "LinkRevoke": {
      "properties": {
        "type": {
          "const": "link.revoke",
          "default": "link.revoke",
          "type": "string"
        }
      },
      "type": "object"
    },
    "McpAdd": {
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/SkillScope",
          "default": "project"
        },
        "type": {
          "const": "mcp.add",
          "default": "mcp.add",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "McpImport": {
      "properties": {
        "type": {
          "const": "mcp.import",
          "default": "mcp.import",
          "type": "string"
        }
      },
      "type": "object"
    },
    "McpRemove": {
      "properties": {
        "name": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "mcp.remove",
          "default": "mcp.remove",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "McpRestart": {
      "properties": {
        "name": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "mcp.restart",
          "default": "mcp.restart",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "McpToggle": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "mcp.toggle",
          "default": "mcp.toggle",
          "type": "string"
        }
      },
      "required": [
        "name",
        "enabled"
      ],
      "type": "object"
    },
    "ParticipantRevoke": {
      "properties": {
        "participant_id": {
          "type": "string"
        },
        "type": {
          "const": "participant.revoke",
          "default": "participant.revoke",
          "type": "string"
        }
      },
      "required": [
        "participant_id"
      ],
      "type": "object"
    },
    "ParticipantSetRole": {
      "properties": {
        "participant_id": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/Role"
        },
        "type": {
          "const": "participant.set_role",
          "default": "participant.set_role",
          "type": "string"
        }
      },
      "required": [
        "participant_id",
        "role"
      ],
      "type": "object"
    },
    "PermissionMode": {
      "enum": [
        "default",
        "accept_edits",
        "plan",
        "auto"
      ],
      "type": "string"
    },
    "PermissionModeSet": {
      "properties": {
        "mode": {
          "$ref": "#/$defs/PermissionMode"
        },
        "type": {
          "const": "session.set_permission_mode",
          "default": "session.set_permission_mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "PolicyAction": {
      "enum": [
        "allow",
        "ask",
        "deny"
      ],
      "type": "string"
    },
    "PolicyAdd": {
      "properties": {
        "action": {
          "$ref": "#/$defs/PolicyAction"
        },
        "pattern": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "tool": {
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "policy.add",
          "default": "policy.add",
          "type": "string"
        }
      },
      "required": [
        "tool",
        "pattern",
        "action"
      ],
      "type": "object"
    },
    "PolicyRemove": {
      "properties": {
        "rule_id": {
          "type": "string"
        },
        "type": {
          "const": "policy.remove",
          "default": "policy.remove",
          "type": "string"
        }
      },
      "required": [
        "rule_id"
      ],
      "type": "object"
    },
    "PromptMode": {
      "enum": [
        "open",
        "review"
      ],
      "type": "string"
    },
    "PromptModeSet": {
      "properties": {
        "mode": {
          "$ref": "#/$defs/PromptMode"
        },
        "type": {
          "const": "session.set_prompt_mode",
          "default": "session.set_prompt_mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "PromptSubmit": {
      "properties": {
        "attachments": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "delivery": {
          "$ref": "#/$defs/Delivery",
          "default": "now"
        },
        "text": {
          "maxLength": 32000,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "prompt.submit",
          "default": "prompt.submit",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "ProposalDecide": {
      "properties": {
        "decision": {
          "$ref": "#/$defs/ProposalDecision"
        },
        "edited_text": {
          "anyOf": [
            {
              "maxLength": 32000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proposal_id": {
          "type": "string"
        },
        "type": {
          "const": "proposal.decide",
          "default": "proposal.decide",
          "type": "string"
        }
      },
      "required": [
        "proposal_id",
        "decision"
      ],
      "type": "object"
    },
    "ProposalDecision": {
      "enum": [
        "approve",
        "reject"
      ],
      "type": "string"
    },
    "QueueCancel": {
      "properties": {
        "prompt_id": {
          "type": "string"
        },
        "type": {
          "const": "queue.cancel",
          "default": "queue.cancel",
          "type": "string"
        }
      },
      "required": [
        "prompt_id"
      ],
      "type": "object"
    },
    "Role": {
      "enum": [
        "host",
        "participant",
        "viewer"
      ],
      "type": "string"
    },
    "RunAbort": {
      "properties": {
        "type": {
          "const": "run.abort",
          "default": "run.abort",
          "type": "string"
        }
      },
      "type": "object"
    },
    "SelectionSet": {
      "properties": {
        "selection": {
          "anyOf": [
            {
              "$ref": "#/$defs/TextSelection"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": {
          "const": "presence.select",
          "default": "presence.select",
          "type": "string"
        }
      },
      "required": [
        "selection"
      ],
      "type": "object"
    },
    "SessionHello": {
      "properties": {
        "client": {
          "$ref": "#/$defs/ClientInfo"
        },
        "invite": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "join": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "name": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "since": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "token": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "session.hello",
          "default": "session.hello",
          "type": "string"
        }
      },
      "required": [
        "client"
      ],
      "type": "object"
    },
    "SkillScope": {
      "enum": [
        "project",
        "global"
      ],
      "type": "string"
    },
    "SkillsInstall": {
      "properties": {
        "package": {
          "maxLength": 200,
          "minLength": 3,
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/SkillScope",
          "default": "project"
        },
        "type": {
          "const": "skills.install",
          "default": "skills.install",
          "type": "string"
        }
      },
      "required": [
        "package"
      ],
      "type": "object"
    },
    "SkillsRemove": {
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "skills.remove",
          "default": "skills.remove",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "SkillsSearch": {
      "properties": {
        "query": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "skills.search",
          "default": "skills.search",
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "type": "object"
    },
    "TextSelection": {
      "description": "Text someone has selected, as offsets into the text of one item on screen.\n\nThe anchor names the item (a feed entry or a canvas document); every client lays\nout the same items, so the offsets point at the same words for everyone.",
      "properties": {
        "anchor": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "end": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        },
        "start": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "anchor",
        "start",
        "end"
      ],
      "type": "object"
    },
    "TypingSet": {
      "properties": {
        "type": {
          "const": "presence.typing",
          "default": "presence.typing",
          "type": "string"
        },
        "typing": {
          "type": "boolean"
        }
      },
      "required": [
        "typing"
      ],
      "type": "object"
    }
  },
  "properties": {
    "command": {
      "discriminator": {
        "mapping": {
          "agents.create": "#/$defs/AgentsCreate",
