      "properties": {
        "decision": {
          "$ref": "#/$defs/ProposalDecision"
        },
        "edited_text": {
          "anyOf": [
            {
              "maxLength": 32000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
