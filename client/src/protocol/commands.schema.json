{
  "$defs": {
    "AdmissionMode": {
      "enum": [
        "approve",
        "open"
      ],
      "type": "string"
    },
    "AdmissionSet": {
      "properties": {
        "mode": {
          "$ref": "#/$defs/AdmissionMode"
        },
        "type": {
          "const": "link.set_admission",
          "default": "link.set_admission",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "type": "object"
    },
    "ApprovalDecision": {
      "enum": [
        "once",
        "always",
        "reject",
        "block"
      ],
      "type": "string"
    },
    "ApprovalRespond": {
      "properties": {
        "approval_id": {
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/ApprovalDecision"
        },
        "type": {
          "const": "approval.respond",
          "default": "approval.respond",
          "type": "string"
        }
      },
      "required": [
        "approval_id",
        "decision"
      ],
      "type": "object"
    },
    "ChatSend": {
      "properties": {
