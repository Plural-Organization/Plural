        "type": {
          "const": "chat.send",
          "default": "chat.send",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "ClientInfo": {
      "properties": {
        "kind": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "version"
      ],
      "type": "object"
    },
    "ContextCompact": {
      "properties": {
        "type": {
          "const": "context.compact",
          "default": "context.compact",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Delivery": {
      "enum": [
        "now",
        "steer",
        "follow_up"
      ],
      "type": "string"
    },
    "FileAttach": {
      "properties": {
        "content_b64": {
          "type": "string"
        },
        "name": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "type": {
          "const": "file.attach",
          "default": "file.attach",
          "type": "string"
        }
      },
      "required": [
        "name",
        "content_b64",
        "sha256"
      ],
      "type": "object"
    },
    "HistoryGet": {
      "properties": {
        "before_seq": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "limit": {
          "default": 100,
          "maximum": 500,
          "minimum": 1,
          "type": "integer"
        },
        "type": {
          "const": "history.get",
          "default": "history.get",
          "type": "string"
        }
      },
      "type": "object"
    },
    "InviteCreate": {
      "properties": {
        "reusable": {
          "default": false,
          "type": "boolean"
        },
        "role": {
          "$ref": "#/$defs/Role",
          "default": "participant"
        },
        "ttl_s": {
          "default": 3600,
          "maximum": 86400,
          "minimum": 60,
          "type": "integer"
        },
        "type": {
          "const": "invite.create",
          "default": "invite.create",
          "type": "string"
        }
      },
      "type": "object"
    },
    "JoinDecide": {
      "properties": {
        "decision": {
          "enum": [
            "allow",
            "viewer",
            "deny"
          ],
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "type": {
          "const": "join.decide",
          "default": "join.decide",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "decision"
      ],
      "type": "object"
    },
    "LinkRevoke": {
      "properties": {
        "type": {
          "const": "link.revoke",
          "default": "link.revoke",
          "type": "string"
        }
      },
      "type": "object"
    },
    "McpAdd": {
      "properties": {
        "args": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "command": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "name": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "scope": {
          "$ref": "#/$defs/SkillScope",
          "default": "project"
        },
        "type": {
          "const": "mcp.add",
          "default": "mcp.add",
          "type": "string"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "McpImport": {
      "properties": {
        "type": {
          "const": "mcp.import",
          "default": "mcp.import",
          "type": "string"
        }
      },
      "type": "object"
    },
    "McpRemove": {
      "properties": {
        "name": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "mcp.remove",
          "default": "mcp.remove",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "McpRestart": {
      "properties": {
        "name": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "mcp.restart",
          "default": "mcp.restart",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "McpToggle": {
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "mcp.toggle",
          "default": "mcp.toggle",
          "type": "string"
