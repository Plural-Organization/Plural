    "SkillsRemove": {
      "properties": {
        "name": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "skills.remove",
          "default": "skills.remove",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "SkillsSearch": {
      "properties": {
        "query": {
          "maxLength": 100,
          "minLength": 1,
          "type": "string"
        },
        "type": {
          "const": "skills.search",
          "default": "skills.search",
          "type": "string"
        }
