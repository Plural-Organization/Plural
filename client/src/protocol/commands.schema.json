          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        "to": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null
